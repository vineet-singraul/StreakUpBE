PORT=5000
CLIENT_URL=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Habit_Tracker?retryWrites=true&w=majority
MONGO_URI_FALLBACK=
MONGO_DB_NAME=Habit_Tracker

JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
REPORT_LANGUAGE=Hinglish

GMAIL_USER=
GMAIL_APP_PASSWORD=

# generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

CALENDAR_START=2026-10
CALENDAR_END=2027-12
REMINDER_CRON=0 8-22 * * *
REPORT_CRON=0 0 * * *

# ---- Free-tier scaling guards (defaults shown; all optional) ----
# Gemini: calls per minute and per day; past the daily limit the app uses plain text instead
GEMINI_RPM=10
GEMINI_DAILY_LIMIT=900
# IST hours when Gemini writes the 30-min notifications (batched 20 users/call); other runs use templates
AI_NOTIFY_HOURS=9,13,17,21
# Emails per day (Brevo free = 300)
MAIL_DAILY_LIMIT=280
# Free MongoDB is 512 MB: how long to keep old tasks / daily reports
TASK_RETENTION_DAYS=180
REPORT_RETENTION_DAYS=60

# Logging in with these Google accounts (comma-separated) opens the admin panel only
ADMIN_EMAILS=bigbasketnex@gmail.com,singhvisal709@gmail.com
